# Recommendation Engine Configuration
# ====================================

# Redis Configuration (Required for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Batch Job Scheduling
# Cron expression for batch computation (default: 0 2 * * * = 2 AM daily)
# Format: "minute hour day month dayOfWeek"
# Examples:
#   - 0 2 * * * = Runs at 2:00 AM every day
#   - 0 2 * * 0 = Runs at 2:00 AM every Sunday
#   - 0 */6 * * * = Runs every 6 hours
BATCH_CRON_SCHEDULE=0 2 * * *

# Batch Size: Number of products to process concurrently
# Lower values = less memory usage but slower
# Higher values = faster but more memory/CPU
BATCH_SIZE=50
